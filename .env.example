# casiagent secrets. Copy this file to .env and fill in the values:
#   cp .env.example .env
# Bun loads .env automatically when you run `bun run start` from this folder.
# .env is ignored by git; never commit real values.
# The variable names below are the defaults; config/casiagent.yaml can point to
# different names (github.token_env, panel.token_env).

# --- Required -----------------------------------------------------------------

# GitHub token for polling the repository, replying, and opening pull requests.
# Create a fine-grained token for the bot account (or yourself, for a first try)
# at https://github.com/settings/personal-access-tokens, limited to the one
# repository, with these permissions:
#   Issues: Read and write · Pull requests: Read and write · Contents: Read
# (git push itself uses the credentials of your local clone, not this token.)
GITHUB_TOKEN=

# Anthropic API key for Claude, from https://console.anthropic.com/settings/keys
# Leave it empty if you have logged in with `ant auth login` instead (an empty
# value is ignored at startup). Tasks fail
# and appear on the attention panel if neither is available.
ANTHROPIC_API_KEY=

# --- Optional -----------------------------------------------------------------

# Bearer token for the attention panel. Used only if config/casiagent.yaml sets
#   panel:
#     token_env: CASIAGENT_PANEL_TOKEN
# Then open the panel as http://127.0.0.1:4317/#token=<this value>.
# Generate one with: openssl rand -hex 32
CASIAGENT_PANEL_TOKEN=
